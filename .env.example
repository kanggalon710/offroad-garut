# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (Neon PostgreSQL)
DATABASE_URL="postgres://user:password@hostname.neon.tech/dbname?sslmode=require"

# Authentication (Better-auth)
BETTER_AUTH_SECRET="super-secret-string-replace-me"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="google-client-id-here"
GOOGLE_CLIENT_SECRET="google-client-secret-here"

# Payment (Midtrans)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
# Nilai yang sama dengan MIDTRANS_CLIENT_KEY. snap.js membacanya di
# browser lewat atribut data-client-key, jadi harus berawalan NEXT_PUBLIC_.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
NEXT_PUBLIC_MIDTRANS_URL="https://app.sandbox.midtrans.com/snap/snap.js"

# Storage (Cloudflare R2)
R2_ACCESS_KEY_ID="r2-access-key"
R2_SECRET_ACCESS_KEY="r2-secret-key"
R2_ENDPOINT="https://xxxx.r2.cloudflarestorage.com"
R2_BUCKET="offroad-garut"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# Akun pengelola awal untuk `pnpm db:seed` (opsional).
# Kalau dikosongkan, seed memakai kredensial bawaan yang hanya layak
# untuk pengembangan lokal.
SEED_ADMIN_EMAIL="pengelola@offroadgarut.id"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Asep Saepudin"

# Notification (Fonnte)
FONNTE_TOKEN="fonnte-api-token"
# Nomor WhatsApp pemilik rental yang menerima notifikasi pesanan baru
OWNER_WHATSAPP="+628122345678"
