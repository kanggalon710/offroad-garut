# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (MySQL/MariaDB — bisa dipakai bersama cPanel NodeJS App)
DATABASE_URL="mysql://user:password@localhost:3306/offroad_garut"

# Database utama (produksi) untuk fitur sync data dev.
# Hanya diisi di server dev (garutoffroad-dev.com). Biarkan kosong di produksi.
# MAIN_DATABASE_URL="mysql://user_prod:password_prod@localhost:3306/offroad_prod"

# Authentication (Better-auth)
BETTER_AUTH_SECRET="super-secret-string-replace-me"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="google-client-id-here"
GOOGLE_CLIENT_SECRET="google-client-secret-here"

# Payment (Midtrans)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
# Nilai yang sama dengan MIDTRANS_CLIENT_KEY. snap.js membacanya di
# browser lewat atribut data-client-key, jadi harus berawalan NEXT_PUBLIC_.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
NEXT_PUBLIC_MIDTRANS_URL="https://app.sandbox.midtrans.com/snap/snap.js"

# Storage (Cloudflare R2) — belum dipakai aktif, lihat DEVIASI-PRD §10
R2_ACCESS_KEY_ID="r2-access-key"
R2_SECRET_ACCESS_KEY="r2-secret-key"
R2_ENDPOINT="https://xxxx.r2.cloudflarestorage.com"
R2_BUCKET="offroad-garut"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# Akun pengelola awal untuk `npm run db:seed`. Wajib diisi, seed menolak
# jalan tanpa ini supaya tidak ada kata sandi bawaan yang ikut ter-commit.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""

# Super admin yang boleh memakai halaman /pembaruan. Dibaca hanya oleh
# `node scripts/set-super-admin.cjs`, tidak pernah oleh aplikasi.
# PIN wajib tepat 6 digit angka. Keduanya wajib diganti saat login pertama.
SUPER_ADMIN_1_EMAIL=""
SUPER_ADMIN_1_PASSWORD=""
SUPER_ADMIN_1_PIN=""
SUPER_ADMIN_2_EMAIL=""
SUPER_ADMIN_2_PASSWORD=""
SUPER_ADMIN_2_PIN=""

# Branch GitHub yang ditarik halaman /pembaruan.
UPDATE_BRANCH="main"
# Isi "false" untuk mematikan tombol pembaruan sepenuhnya.
UPDATE_ENABLED="true"

# Notification (Fonnte)
FONNTE_TOKEN="fonnte-api-token"
# Nomor WhatsApp pemilik rental yang menerima notifikasi pesanan baru
OWNER_WHATSAPP="+628122345678"
